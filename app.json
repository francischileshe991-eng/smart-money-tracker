{
  "expo": {
    "name": "Smart Money Tracker",
    "slug": "smart-money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartmoneytracker",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "android": {
      "package": "com.smartmoneytracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#123D30",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.smartmoneytracker.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123D30",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9ccfb4bc-592d-45c5-aae7-33846fbfa95f"
      }
    },
    "owner": "chileshe_francis"
  }
}
